# Merge into the existing /home/ploi/sendae.app/.env.
# Preserve APP_KEY and the existing database. Replace every REPLACE value.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sendae.app
LOG_LEVEL=warning
SESSION_SECURE_COOKIE=true
